{
  "name": "bytechat-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch app/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
