    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bytechat": "file:..",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.0.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
