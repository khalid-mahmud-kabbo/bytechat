NODE_ENV=development
PORT=4000
# app runtime -> Neon POOLED url (host contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# prisma migrate -> Neon DIRECT url (no -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32chars-min
OTP_SECRET=change-me-another-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CLIENT_ORIGINS=http://localhost:3000
# public base url of this API (used to build media links)
PUBLIC_URL=http://localhost:4000
