# ---- file storage: leave S3_* empty to keep using the local ./uploads folder ----
# Cloudflare R2 example: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto,
# S3_PUBLIC_URL = the bucket's public r2.dev URL or your custom domain
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---- web push (generate with: npx web-push generate-vapid-keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- calls: STUN works out of the box; add a TURN server so calls connect on strict networks ----
