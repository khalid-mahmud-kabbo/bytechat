generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ChatType {
  DIRECT
  GROUP
}

enum MemberRole {
  MEMBER
  ADMIN
  OWNER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  VOICE
  DOCUMENT
  SYSTEM
}

model User {
  id         String    @id @default(cuid())
  phone      String    @unique
  name       String?
  about      String    @default("Hey there! I am using ByteChat")
  avatarUrl  String?
  role       UserRole  @default(USER)
  isBanned   Boolean   @default(false)
  isOnline   Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  refreshTokens RefreshToken[]
  memberships   ChatMember[]
  messages      Message[]
  receipts      MessageReceipt[]
  reactions     Reaction[]
  media         Media[]
  chatsCreated  Chat[]           @relation("ChatCreator")
  blocksMade    Block[]          @relation("Blocker")
  blocksGot     Block[]          @relation("Blocked")
  stories       Story[]
  storyViews    StoryView[]
  callsMade     CallLog[]        @relation("Caller")
  callsGot      CallLog[]        @relation("Callee")
  pushSubs      PushSubscription[]

  @@index([createdAt])
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model Chat {
  id            String    @id @default(cuid())
  type          ChatType
  // DIRECT chats only: "<smallerUserId>:<largerUserId>" so a pair can never have two chats
  directKey     String?   @unique
  name          String?
  description   String?
  avatarUrl     String?
  isSystem      Boolean   @default(false) // e.g. "ByteChat Support"
  createdById   String?
  lastMessageId String?   @unique
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy   User?        @relation("ChatCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastMessage Message?     @relation("ChatLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  members     ChatMember[]
  messages    Message[]    @relation("ChatMessages")

  @@index([lastMessageAt(sort: Desc)])
}

model ChatMember {
  id          String     @id @default(cuid())
  chatId      String
  userId      String
  role        MemberRole @default(MEMBER)
  // Unread count = messages in this chat newer than lastReadAt, not sent by me
  lastReadAt  DateTime   @default(now())
  mutedUntil  DateTime?
  pinnedAt    DateTime?
  archivedAt  DateTime?
  joinedAt    DateTime   @default(now())
  leftAt      DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Media {
  id           String   @id @default(cuid())
  uploaderId   String
  key          String   // storage object key (R2/S3)
  url          String
  thumbnailUrl String?
  mimeType     String
  size         Int
  fileName     String?
  width        Int?
  height       Int?
  durationMs   Int?
  waveform     Int[]    // peak values captured at recording time (voice messages)
  createdAt    DateTime @default(now())

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message  Message?
  story    Story?

  @@index([uploaderId])
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  senderId  String
  type      MessageType @default(TEXT)
  text      String?
  mediaId   String?     @unique
  replyToId String?
  // client-generated id so offline resend never creates duplicates
  clientId  String?
  editedAt  DateTime?
  deletedAt DateTime?   // deleted for everyone
  createdAt DateTime    @default(now())

  chat      Chat             @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  sender    User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  media     Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  replyTo   Message?         @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]        @relation("Replies")
  lastOfChat Chat?           @relation("ChatLastMessage")
  receipts  MessageReceipt[]
  reactions Reaction[]

  @@unique([senderId, clientId])
  @@index([chatId, createdAt(sort: Desc)])
  @@index([chatId, type, createdAt(sort: Desc)])
}

model MessageReceipt {
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// ---------------- stories (24h status) ----------------
enum StoryType {
  TEXT
  IMAGE
  VIDEO
}

model Story {
  id        String    @id @default(cuid())
  userId    String
  type      StoryType
  text      String?
  bgColor   String?
  mediaId   String?   @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media?      @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  views StoryView[]

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model StoryView {
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
  @@index([viewerId])
}

// ---------------- calls ----------------
enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACCEPTED
  ENDED
  MISSED
  DECLINED
  CANCELED
}

model CallLog {
  id          String     @id @default(cuid())
  callerId    String
  calleeId    String
  type        CallType
  status      CallStatus @default(RINGING)
  startedAt   DateTime   @default(now())
  answeredAt  DateTime?
  endedAt     DateTime?
  durationSec Int?

  caller User @relation("Caller", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("Callee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([callerId, startedAt(sort: Desc)])
  @@index([calleeId, startedAt(sort: Desc)])
}

// ---------------- web push ----------------
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
